# Copy this file to `.env` and fill in the values. `.env` is git-ignored: never commit real keys.

# --- OpenAI (optional: without a key the app runs in a clearly labelled deterministic fallback mode) ---
OPENAI_API_KEY=
# Any chat model that supports function calling with strict schemas. Change it freely.
OPENAI_MODEL=gpt-4o-mini

# auto          use the LLM when a key is set; if the provider fails (rate limit, timeout, outage) fall back
#               to the deterministic router/extractor and say so in the response
# llm           strict: provider problems are reported as errors, there is never a silent fallback
# deterministic never call the LLM (offline demos, tests)
LLM_MODE=auto

# --- Optional ---
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint, e.g. Google Gemini:
#                             #   https://generativelanguage.googleapis.com/v1beta/openai/   (then OPENAI_MODEL=gemini-3.5-flash-lite)
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=2        # SDK-level retries for network errors (1 is better on a free tier: failures show up fast, then the LLM is paused)
# EXTRA_CATALOG_DIRS=examples/extension_wf011   # load the demo 11th workflow (path-separated list)
# LOG_LEVEL=INFO
# WORKFLOW_WORKBOOK=data/workflows.xlsx
